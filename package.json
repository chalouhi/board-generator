{
  "name": "board-generator",
  "version": "1.1.0",
  "description": "One file of cards in, one board out: web page, picture (SVG) and PDF (A4).",
  "license": "MIT",
  "bin": { "board": "bin/board.js" },
  "main": "src/board.js",
  "files": ["bin/", "src/", "vendor/", "fonts/", "docs/", "samples/"],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test tests/browser/page.test.js tests/browser/card.test.js",
    "build:demo": "node tools/build-demo-data.js",
    "freeze": "node tools/freeze-expected.js"
  },
  "engines": { "node": ">=18" },
  "private": true
}
